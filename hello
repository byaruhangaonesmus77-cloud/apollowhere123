<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Random Number Picker</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background: linear-gradient(to right, #74ebd5, #ACB6E5);
      color: #333;
      margin: 0;
      padding: 40px;
    }
    h1 {
      margin-bottom: 20px;
    }
    button {
      padding: 15px 30px;
      font-size: 18px;
      border: none;
      border-radius: 8px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
      transition: transform 0.2s;
    }
    button:hover {
      transform: scale(1.05);
      background-color: #45a049;
    }
    #result {
      font-size: 24px;
      margin-top: 20px;
      font-weight: bold;
    }
    #taken {
      margin-top: 30px;
      font-size: 18px;
    }
    #reset {
      margin-top: 20px;
      background-color: #f44336;
    }
    #reset:hover {
      background-color: #d32f2f;
    }
  </style>
</head>
<body>
  <h1>🎲 Random Number Picker</h1>
  <button onclick="pickNumber()">Tap to Pick</button>
  <p id="result"></p>
  <div id="taken">Numbers taken: None</div>
  <button id="reset" onclick="resetGame()">Reset</button>

  <script>
    let numbers = [1,2,3,4,5,6,7];
    let taken = [];

    function pickNumber() {
      if (numbers.length === 0) {
        document.getElementById("result").innerText = "All numbers taken!";
        return;
      }
      let index = Math.floor(Math.random() * numbers.length);
      let chosen = numbers.splice(index, 1)[0];
      taken.push(chosen);
      document.getElementById("result").innerText = "You got: " + chosen;
      document.getElementById("taken").innerText = "Numbers taken: " + taken.join(", ");
    }

    function resetGame() {
      numbers = [1,2,3,4,5,6,7];
      taken = [];
      document.getElementById("result").innerText = "";
      document.getElementById("taken").innerText = "Numbers taken: None";
    }
  </script>
</body>
</html>
